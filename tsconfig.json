{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["src", "shared", "api"],
  "_comment": "Tests are excluded from the app/Vercel build: they may import from packages absent in the Vercel upload (e.g. mcp/, which .vercelignore drops), and are typechecked by vitest instead. Compiling them here made `tsc -b` fail on Vercel while `tsc --noEmit` passed in CI, where mcp/ is present.",
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
