{
  "name": "parity-studio-mcp",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "description": "MCP server for Parity Studio and NodeSlide. Gives coding agents governed deck reads, reviewable edits, traces, and design-to-code workflows.",
  "license": "MIT",
  "homepage": "https://github.com/HomenShum/parity-studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HomenShum/parity-studio.git",
    "directory": "mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "cursor",
    "ui-generation",
    "design-to-code",
    "decompose",
    "ui-kit",
    "parity",
    "anthropic",
    "openai"
  ],
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "bin": {
    "parity-studio-mcp": "dist/index.js"
  },
  "scripts": {
    "prebuild": "pnpm --filter @parity/nodeslide-agent-client build",
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --alias:@parity/nodeslide-agent-client=../packages/nodeslide-agent-client/dist/index.js --outfile=dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@earendil-works/pi-ai": "0.80.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.12.29",
    "jszip": "^3.10.1",
    "open": "^10.1.0",
    "playwright": "^1.61.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@parity/nodeslide-agent-client": "workspace:*",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
