{
  "name": "parity-studio-mcp",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "description": "MCP server for Parity Studio. Lets coding agents capture existing app routes, decompose them into ui_kit/ bundles, and import them for iteration.",
  "license": "MIT",
  "homepage": "https://github.com/HomenShum/parity-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/HomenShum/parity-studio.git",
    "directory": "mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "cursor",
    "ui-generation",
    "design-to-code",
    "decompose",
    "ui-kit",
    "parity",
    "anthropic",
    "openai"
  ],
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "bin": {
    "parity-studio-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@mariozechner/pi-ai": "^0.70.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.6.0",
    "jszip": "^3.10.1",
    "open": "^10.1.0",
    "playwright": "^1.59.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
