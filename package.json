{
  "name": "parity-studio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Image -> componentized ui_kit -> verified handoff to coding agents. Boolean parity rubric, honest score drift, self-dogfooding pipeline.",
  "scripts": {
    "dev": "concurrently -n vite,convex -c blue,magenta \"vite\" \"convex dev\"",
    "dev:web": "vite",
    "dev:backend": "convex dev",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build",
    "vercel-build": "if [ -n \"$CONVEX_DEPLOY_KEY\" ]; then convex deploy --cmd 'tsc -b && vite build' --typecheck disable; else echo 'no CONVEX_DEPLOY_KEY — skipping backend deploy, building frontend with committed _generated/' && tsc -b && vite build; fi",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@convex-dev/persistent-text-streaming": "^0.2.0",
    "@convex-dev/workflow": "^0.3.0",
    "@mariozechner/pi-ai": "^0.70.2",
    "@monaco-editor/react": "^4.7.0",
    "@sinclair/typebox": "^0.34.0",
    "convex": "^1.30.0",
    "jszip": "^3.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "playwright": "^1.59.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
