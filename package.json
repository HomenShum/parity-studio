{
  "name": "parity-studio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "NodeSlide creates editable, reviewable presentations from structured briefs, with scoped AI changes, sources, versions, and verified exports.",
  "scripts": {
    "dev": "concurrently -n vite,convex -c blue,magenta \"vite\" \"convex dev\"",
    "dev:web": "vite",
    "dev:backend": "convex dev",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "preview": "vite preview",
    "proof:nodeslide": "node scripts/nodeslide-proof.mjs",
    "proof:nodeslide:w2": "node scripts/nodeslide-signature-apply-proof.mjs",
    "proof:nodeslide:w3": "node scripts/nodeslide-variation-proof.mjs",
    "proof:nodeslide:w4": "node scripts/nodeslide-preference-proof.mjs",
    "proof:nodeslide:w5": "node scripts/nodeslide-taste-pack-proof.mjs",
    "proof:nodeslide:agentic": "node scripts/nodeslide-agentic-proof.mjs",
    "proof:nodeslide:agentic:local": "node scripts/nodeslide-agentic-local-switch-proof.mjs",
    "proof:nodeslide:ui": "node scripts/nodeslide-agent-operability-proof.mjs",
    "proof:nodeslide:hero": "node scripts/nodeslide-production-hero-proof.mjs",
    "proof:nodeslide:journey": "node scripts/nodeslide-journey-proof.mjs",
    "proof:nodeslide:journey:gif": "node scripts/nodeslide-journey-gif.mjs",
    "nodeslide:authoring:meta": "node scripts/nodeslide-authoring-meta.mjs",
    "test:e2e:nodeslide:journey": "node scripts/run-nodeslide-journey-e2e.mjs",
    "nodeslide:bench": "node scripts/nodeslide-benchmark-gate.mjs --mode evidence",
    "nodeslide:bench:pr": "node scripts/nodeslide-benchmark-gate.mjs --mode pr",
    "nodeslide:bench:evidence": "node scripts/nodeslide-benchmark-gate.mjs --mode evidence",
    "nodeslide:bench:produce-live": "playwright test tests/e2e/nodeslide-benchmark-producer.live.spec.ts --retries=0 --workers=1",
    "nodeslide:bench:taste-judge": "node scripts/nodeslide-taste-judge.mjs",
    "nodeslide:bench:competitive": "node scripts/nodeslide-competitive-benchmark.mjs",
    "test:nodeslide-bench": "vitest run scripts/tests/nodeslide-benchmark-gate.test.mjs scripts/tests/nodeslide-uxbench.test.mjs scripts/tests/nodeslide-tastebench.test.mjs scripts/tests/nodeslide-benchmark-producer.test.mjs scripts/tests/nodeslide-taste-judge.test.mjs scripts/tests/nodeslide-competitive-benchmark.test.mjs",
    "qa:manifest": "node scripts/validate-qa-manifest.mjs",
    "check:built-runtime-source": "node scripts/check-built-runtime-source.mjs",
    "check:runtime-source": "node scripts/check-runtime-source.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:nodeslide-agent-ui": "node scripts/nodeslide-agent-ui-linter.mjs",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@assistant-ui/react": "0.14.26",
    "@assistant-ui/react-o11y": "0.0.25",
    "@assistant-ui/store": "0.2.19",
    "@convex-dev/persistent-text-streaming": "^0.3.3",
    "@convex-dev/workflow": "^0.3.0",
    "@earendil-works/pi-ai": "0.80.6",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "@openuidev/react-lang": "0.2.8",
    "@sinclair/typebox": "^0.34.0",
    "ai": "^7.0.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.42.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.12.0",
    "nanoid": "^6.0.0",
    "pdfjs-dist": "^6.1.200",
    "pptxgenjs": "^4.0.1",
    "radix-ui": "^1.6.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "zod": "^4.3.6"
  },
  "pnpm": {
    "overrides": {
      "@protobufjs/utf8": "^1.1.2",
      "dompurify": "^3.4.11",
      "protobufjs": "7.6.3",
      "ws": "^8.21.0"
    }
  }
}
