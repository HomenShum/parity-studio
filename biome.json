{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "files": {
    "ignore": [
      ".convex",
      ".claude",
      ".understand-anything",
      ".playwright-mcp",
      ".tmp",
      ".vercel",
      "blob-report",
      "dist",
      "docs/dogfood",
      "docs/plans/assets",
      "docs/demo/founder-roadshow/lighthouse-desktop-2026-07-14.json",
      "docs/demo/founder-roadshow/lighthouse-mobile-2026-07-14.json",
      "docs/demo/founder-roadshow/production-e2e-2026-07-14.json",
      "artifacts/nodeslide-three-deck-launch-final-v22",
      "convex/_generated",
      "mcp/dist",
      "mcp/src/generated",
      "shared/generated",
      "node_modules",
      "playwright-report",
      "runs",
      "test-results",
      "*.log",
      "*.tsbuildinfo"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  },
  "organizeImports": {
    "enabled": true
  }
}
