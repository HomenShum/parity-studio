{
  "$schema": "../fixture.schema.json",
  "schemaVersion": "nodeslide-agent-fixture/v1",
  "id": "E01",
  "title": "Selected-element copy edit",
  "category": "scoped_copy_editing",
  "minimumRelease": true,
  "setup": {
    "deckFixture": "founder-roadshow-v1",
    "activeSlideId": "slide-problem",
    "selectedSlideIds": ["slide-problem"],
    "selectedElementIds": ["headline-problem"],
    "approvalMode": "review_required",
    "autonomyGrant": null,
    "context": {
      "description": "One unlocked headline is selected on the problem slide; all other elements are out of scope.",
      "attachments": [],
      "web": {
        "allowed": false,
        "authorizedOrigins": []
      },
      "canonicalBefore": {
        "deckVersion": 7,
        "element": {
          "id": "headline-problem",
          "version": 3,
          "text": "The problem",
          "sourceIds": [],
          "locked": false
        }
      }
    }
  },
  "request": {
    "text": "Make this headline clearer for an investor.",
    "attachmentIds": [],
    "webResearch": false
  },
  "expected": {
    "primitives": ["text"],
    "operations": {
      "required": [
        {
          "type": "replace_text",
          "minCount": 1,
          "maxCount": 1,
          "scope": "selected_element"
        }
      ],
      "allowed": ["replace_text"],
      "denied": ["update_layout", "replace_image", "update_chart", "publish", "share"]
    },
    "authority": {
      "mode": "review_required",
      "proposalRequired": true,
      "canonicalMutationBeforeReview": false,
      "requiredEvents": [
        "scope_checked",
        "selection_scope_checked",
        "proposal_created",
        "human_review_requested"
      ],
      "forbiddenEvents": ["auto_commit", "publish", "share"],
      "boundaryBehavior": "Propose one replacement for the selected headline and wait for acceptance."
    },
    "outcomes": [
      "Exactly one replace_text operation targets the selected headline.",
      "No other element or slide changes.",
      "The canonical headline stays unchanged until review acceptance."
    ]
  },
  "trace": {
    "ordered": true,
    "mustInclude": [
      "read_context",
      "resolve_scope",
      "check_authority",
      "plan",
      "execute",
      "candidate_validation",
      "human_review"
    ]
  },
  "forbidden": [
    "unselected_element_change",
    "deck_wide_rewrite",
    "source_binding_change",
    "canonical_mutation_before_review"
  ],
  "assertions": [
    {
      "id": "one-operation",
      "description": "The run contains exactly one operation.",
      "actual": {
        "evidenceKind": "run_record",
        "pointer": "/operations"
      },
      "operator": "length_equals",
      "expected": 1
    },
    {
      "id": "selected-target-only",
      "description": "The operation targets only the selected headline.",
      "actual": {
        "evidenceKind": "run_record",
        "pointer": "/operations",
        "itemPointer": "/targets/0"
      },
      "operator": "set_equals",
      "expected": ["headline-problem"]
    },
    {
      "id": "headline-changed",
      "description": "The proposed headline text differs from the original text.",
      "actual": {
        "evidenceKind": "run_record",
        "pointer": "/result/before/text",
        "comparePointer": "/result/after/text"
      },
      "operator": "changed"
    },
    {
      "id": "bounded-element-set",
      "description": "Only the selected element is in the changed-element receipt.",
      "actual": {
        "evidenceKind": "run_record",
        "pointer": "/result/changedElementIds"
      },
      "operator": "set_equals",
      "expected": ["headline-problem"]
    }
  ]
}
