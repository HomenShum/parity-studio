{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodeslide.test/schemas/taste-judge-v1.json",
  "title": "NodeSlide TasteBench independent visual judgment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "judgmentId",
    "caseId",
    "bindings",
    "rubric",
    "provenance",
    "assessments"
  ],
  "properties": {
    "schemaVersion": { "const": "nodeslide-taste-judge/v1" },
    "judgmentId": { "type": "string", "minLength": 1 },
    "caseId": { "type": "string", "pattern": "^[A-Z][0-9]{2}$" },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beforeArtifactId",
        "beforeManifestDigest",
        "afterArtifactId",
        "afterManifestDigest",
        "pixelPairs"
      ],
      "properties": {
        "beforeArtifactId": { "type": "string", "minLength": 1 },
        "beforeManifestDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "afterArtifactId": { "type": "string", "minLength": 1 },
        "afterManifestDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pixelPairs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["beforePixelId", "afterPixelId"],
            "properties": {
              "beforePixelId": { "type": "string", "minLength": 1 },
              "afterPixelId": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "const": "nodeslide-held-out-taste/v1" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["judgedAt", "judgeType", "producer", "model", "promptDigest"],
      "properties": {
        "judgedAt": { "type": "string", "format": "date-time" },
        "judgeType": { "const": "independent_visual_judge" },
        "producer": { "$ref": "#/$defs/producer" },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "name", "version"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "promptDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "beforeScore", "afterScore", "confidence", "pixelPairs"],
        "properties": {
          "ruleId": { "type": "string", "minLength": 1 },
          "beforeScore": { "type": "number" },
          "afterScore": { "type": "number" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "pixelPairs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["beforePixelId", "afterPixelId"],
              "properties": {
                "beforePixelId": { "type": "string", "minLength": 1 },
                "afterPixelId": { "type": "string", "minLength": 1 }
              }
            }
          },
          "rationale": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
