{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodeslide.test/schemas/ux-run-record-v1.json",
  "title": "NodeSlide UXBench hash-verified run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "caseId",
    "request",
    "operations",
    "authority",
    "trace",
    "forbiddenBehaviorsObserved",
    "result"
  ],
  "properties": {
    "schemaVersion": { "const": "nodeslide-ux-run-record/v1" },
    "runId": { "type": "string", "minLength": 1 },
    "caseId": { "type": "string", "pattern": "^[A-Z][0-9]{2}$" },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "attachmentIds", "webResearch"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "attachmentIds": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "webResearch": { "type": "boolean" }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "scope", "targets"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "targets": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "status": { "type": "string" }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "proposalRequired", "canonicalMutationBeforeReview", "events"],
      "properties": {
        "mode": { "enum": ["review_required", "autonomous"] },
        "proposalRequired": { "type": "boolean" },
        "canonicalMutationBeforeReview": { "type": "boolean" },
        "events": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "stage"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 0 },
          "stage": { "type": "string", "minLength": 1 }
        }
      }
    },
    "forbiddenBehaviorsObserved": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "result": { "type": "object" }
  }
}
