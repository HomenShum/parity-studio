{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodeslide.test/schemas/taste-artifact-v1.json",
  "title": "NodeSlide TasteBench before/after pixel manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactId", "caseId", "phase", "provenance", "capture", "pixels"],
  "properties": {
    "schemaVersion": { "const": "nodeslide-taste-artifact/v1" },
    "artifactId": { "type": "string", "minLength": 1 },
    "caseId": { "type": "string", "pattern": "^[A-Z][0-9]{2}$" },
    "phase": { "enum": ["before", "after"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capturedAt", "producer", "sourceRevision", "captureMethod"],
      "properties": {
        "capturedAt": { "type": "string", "format": "date-time" },
        "producer": { "$ref": "#/$defs/producer" },
        "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "captureMethod": { "const": "browser_screenshot" }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slideId", "stateDigest", "viewport"],
      "properties": {
        "slideId": { "type": "string", "minLength": 1 },
        "stateDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "deviceScaleFactor"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "deviceScaleFactor": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "pixels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256", "byteLength", "width", "height", "mediaType"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "byteLength": { "type": "integer", "minimum": 1 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "mediaType": { "enum": ["image/png", "image/jpeg", "image/webp"] }
        }
      }
    }
  },
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
